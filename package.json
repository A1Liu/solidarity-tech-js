{
  "name": "@a1liu/solidarity-tech-api",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "version": "0.1.14",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/bun": "latest",
    "genson-js": "^0.0.8",
    "json-schema-to-zod": "^2.8.1",
    "prettier": "^3.8.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "probe": "bun run ./scripts/probe.ts",
    "capture": "bun run ./scripts/capture.ts",
    "draft": "bun run ./scripts/draft.ts",
    "test:script": "bun run ./scripts/test.ts",
    "vitest": "vitest run",
    "format": "prettier --write .",
    "update": "bun run ./scripts/update.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.4.3"
